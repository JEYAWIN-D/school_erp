generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_terms {
  id               BigInt         @id @default(autoincrement())
  academic_year_id BigInt
  name             String         @db.VarChar(255)
  type             String         @default("term") @db.VarChar(255)
  start_date       DateTime       @db.Date
  end_date         DateTime       @db.Date
  order_position   Int            @default(1) @db.SmallInt
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  academic_years   academic_years @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "academic_terms_academic_year_id_foreign")
}

model academic_years {
  id                                                                          BigInt                      @id @default(autoincrement())
  name                                                                        String                      @db.VarChar(255)
  start_date                                                                  DateTime                    @db.Date
  end_date                                                                    DateTime                    @db.Date
  is_current                                                                  Boolean                     @default(false)
  is_locked                                                                   Boolean                     @default(false)
  created_at                                                                  DateTime?                   @db.Timestamp(0)
  updated_at                                                                  DateTime?                   @db.Timestamp(0)
  academic_terms                                                              academic_terms[]
  activity_learning_records                                                   activity_learning_records[]
  attendance_condonations                                                     attendance_condonations[]
  attendance_records                                                          attendance_records[]
  competency_assessments                                                      competency_assessments[]
  coscholastic_assessments                                                    coscholastic_assessments[]
  enquiries                                                                   enquiries[]
  exams                                                                       exams[]
  fee_carry_forwards_fee_carry_forwards_from_academic_year_idToacademic_years fee_carry_forwards[]        @relation("fee_carry_forwards_from_academic_year_idToacademic_years")
  fee_carry_forwards_fee_carry_forwards_to_academic_year_idToacademic_years   fee_carry_forwards[]        @relation("fee_carry_forwards_to_academic_year_idToacademic_years")
  fee_payments                                                                fee_payments[]
  fee_structures                                                              fee_structures[]
  holidays                                                                    holidays[]
  hostel_allotments                                                           hostel_allotments[]
  hostel_fee_structures                                                       hostel_fee_structures[]
  lesson_plans                                                                lesson_plans[]
  sections                                                                    sections[]
  student_custom_fees                                                         student_custom_fees[]
  student_enrollments                                                         student_enrollments[]
  syllabus                                                                    syllabus[]
  timetables                                                                  timetables[]
  transport_allotments                                                        transport_allotments[]
}

model activity_learning_records {
  id               BigInt         @id @default(autoincrement())
  student_id       BigInt
  academic_year_id BigInt
  activity_name    String         @db.VarChar(255)
  activity_type    String         @db.VarChar(255)
  description      String?
  activity_date    DateTime       @db.Date
  outcome          String?        @db.VarChar(255)
  attachment       String?        @db.VarChar(255)
  recorded_by      BigInt?
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  academic_years   academic_years @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_learning_records_academic_year_id_foreign")
  students         students       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_learning_records_student_id_foreign")
}

model admission_stages {
  id             BigInt    @id @default(autoincrement())
  enquiry_id     BigInt
  stage          String    @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(255)
  scheduled_date DateTime? @db.Date
  scheduled_time DateTime? @db.Time(0)
  venue          String?   @db.VarChar(255)
  score          Decimal?  @db.Decimal(5, 2)
  remarks        String?
  done_by        BigInt?
  completed_at   DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  enquiries      enquiries @relation(fields: [enquiry_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admission_stages_enquiry_id_foreign")
}

model alumni {
  id                 BigInt               @id @default(autoincrement())
  student_id         BigInt?
  first_name         String               @db.VarChar(255)
  last_name          String               @db.VarChar(255)
  email              String?              @db.VarChar(255)
  phone              String?              @db.VarChar(255)
  passing_year       Int
  last_class         String?              @db.VarChar(255)
  current_occupation String?              @db.VarChar(255)
  current_employer   String?              @db.VarChar(255)
  current_city       String?              @db.VarChar(255)
  achievements       String?
  profile_photo      String?              @db.VarChar(255)
  linkedin_url       String?              @db.VarChar(255)
  is_verified        Boolean              @default(false)
  is_active          Boolean              @default(true)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  students           students?            @relation(fields: [student_id], references: [id], onUpdate: NoAction, map: "alumni_student_id_foreign")
  alumni_event_rsvps alumni_event_rsvps[]
}

model alumni_event_rsvps {
  id            BigInt        @id @default(autoincrement())
  event_id      BigInt
  alumni_id     BigInt
  attending     Boolean       @default(true)
  created_at    DateTime?     @db.Timestamp(0)
  updated_at    DateTime?     @db.Timestamp(0)
  alumni        alumni        @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "alumni_event_rsvps_alumni_id_foreign")
  alumni_events alumni_events @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "alumni_event_rsvps_event_id_foreign")

  @@unique([event_id, alumni_id], map: "alumni_event_rsvps_event_id_alumni_id_unique")
}

model alumni_events {
  id                 BigInt               @id @default(autoincrement())
  title              String               @db.VarChar(255)
  event_date         DateTime             @db.Date
  description        String?
  venue              String?              @db.VarChar(255)
  is_published       Boolean              @default(false)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  alumni_event_rsvps alumni_event_rsvps[]
}

model application_form_configs {
