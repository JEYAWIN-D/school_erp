/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_records {
  id                                                 BigInt         @id @default(autoincrement())
  student_id                                         BigInt
  class_id                                           BigInt
  section_id                                         BigInt?
  academic_year_id                                   BigInt
  date                                               DateTime       @db.Date
  status                                             String         @default("present") @db.VarChar(255)
  remark                                             String?        @db.VarChar(255)
  marked_by                                          BigInt?
  created_at                                         DateTime?      @db.Timestamp(0)
  updated_at                                         DateTime?      @db.Timestamp(0)
  period_data                                        Json?          @db.Json
  arrival_time                                       DateTime?      @db.Time(0)
  departure_time                                     DateTime?      @db.Time(0)
  is_late                                            Boolean        @default(false)
  cutoff_override                                    Boolean        @default(false)
  cutoff_override_by                                 BigInt?
  academic_years                                     academic_years @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_records_academic_year_id_foreign")
  classes                                            classes        @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_records_class_id_foreign")
