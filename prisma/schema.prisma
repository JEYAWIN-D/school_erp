  users_attendance_records_marked_byTousers          users?         @relation("attendance_records_marked_byTousers", fields: [marked_by], references: [id], onUpdate: NoAction, map: "attendance_records_marked_by_foreign")
  sections                                           sections?      @relation(fields: [section_id], references: [id], onUpdate: NoAction, map: "attendance_records_section_id_foreign")
